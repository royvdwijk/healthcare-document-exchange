@HostAddress = http://localhost:5100

GET {{HostAddress}}/openapi/v1.json
Accept: application/json

### Receive a referral letter
POST {{HostAddress}}/api/referrals
Content-Type: application/json

{
  "patient": {
    "bsn": "999990019",
    "name": "Jan Jansen",
    "dateOfBirth": "1942-03-14",
    "allergies": [
      { "substance": "Penicillin", "reaction": "Skin rash" }
    ]
  },
  "reason": "TEST. Discharged after hip surgery, requires rehabilitation care."
}

### Get a patient
GET {{HostAddress}}/api/patients/999990019
Accept: application/json

### Get a patient, including their allergies
GET {{HostAddress}}/api/patients/999990019?include=allergies
Accept: application/json

###
